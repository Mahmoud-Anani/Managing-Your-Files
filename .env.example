# ---------------------------------------------------------------------------
# Root environment file for `docker compose`.
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- PostgreSQL container (internal to the compose network) ---------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=managing_your_files

# --- API / client wiring --------------------------------------------------
CLIENT_ORIGIN=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- Server application ---------------------------------------------------
NODE_ENV=production
PORT=3001

# Required by the API at boot. At least 16 characters.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seed admin account (created on first start)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=Admin123

# SMTP / email (leave GMAIL_USER + GMAIL_PASS empty to log codes to console)
GMAIL_USER=
GMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=Managing Your Files <no-reply@example.com>

# Upload limit (1-100 MB)
MAX_FILE_SIZE_MB=25

# Required by the API at boot (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=