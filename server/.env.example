# Environment variables for the server
NODE_ENV=development
PORT=3001
# Base URL for the server (used in email templates and other places)
BASE_URL=https://managing-your-files-production.up.railway.app
# CORS
CLIENT_ORIGIN=http://localhost:3002
# PostgreSQL database connection string
DATABASE_URL=postgresql://user:pass@localhost:5432/managing_your_files
# JWT
JWT_SECRET=change-me-at-least-16-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-at-least-16-chars
JWT_REFRESH_EXPIRES_IN=7d
# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=Admin123
# Email / Brevo
# Set BREVO_API_KEY and EMAIL_FROM on Railway to enable production email delivery.
# EMAIL_FROM must be a sender verified in Brevo via "Single Sender Verification"
# (no domain/DNS setup required). When empty, OTP codes are logged to the console
# instead (development mode).
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME="Managing Your Files"
# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
