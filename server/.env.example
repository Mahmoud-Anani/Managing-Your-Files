# ---------------------------------------------------------------------------
# Server environment. Copy to `.env` and fill in real values.
# `DATABASE_URL` and `JWT_SECRET` are required at boot.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:3002

# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/managing_your_files
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seed admin
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=Admin123

# SMTP / email (leave GMAIL_USER + GMAIL_PASS empty to log codes to console)
GMAIL_USER=
GMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=Managing Your Files <no-reply@example.com>

# Upload limit (1-100 MB)
MAX_FILE_SIZE_MB=25

# Required (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=